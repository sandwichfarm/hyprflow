+        const int fd = open(selected, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+        drmDevicePtr device = nullptr;
+        const bool valid = fd >= 0 && drmGetNodeTypeFromFd(fd) == DRM_NODE_RENDER && drmGetDevice2(fd, 0, &device) == 0 &&
