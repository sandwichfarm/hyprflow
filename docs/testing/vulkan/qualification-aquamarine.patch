+        if (device)
+            drmFreeDevice(&device);
+        if (!valid) {
+            if (fd >= 0)
+                close(fd);
+            backend->log(AQ_LOG_ERROR, "HYPRFLOW_TEST_RENDER_NODE is not an accessible AMD DRM render node");
+            return false;
+        }
+        qualificationRenderNode = Hyprutils::OS::CFileDescriptor{fd};
+        backend->log(AQ_LOG_WARNING, std::format("Hyprflow isolated headless AMD render node: {}", selected));
+    }
     return true;
